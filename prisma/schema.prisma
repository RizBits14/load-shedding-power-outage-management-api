generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InfrastructureStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum AreaPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OutageReportStatus {
  PENDING
  VERIFIED
  LINKED
  REJECTED
}

enum OutageIssueType {
  TOTAL_OUTAGE
  PARTIAL_OUTAGE
  VOLTAGE_FLUCTUATION
  OTHER
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESTORED
  CLOSED
  CANCELLED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  COMPLETED
  REASSIGNED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NotificationType {
  OUTAGE_REPORT
  INCIDENT
  ASSIGNMENT
  BILL
  PAYMENT
  SYSTEM
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  googleId String? @unique

  role   Role       @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  customerProfile CustomerProfile?

  createdSchedules OutageSchedule[]
  createdIncidents OutageIncident[] @relation("CreatedIncidents")

  outageReports         OutageReport[] @relation("CustomerOutageReports")
  reviewedOutageReports OutageReport[] @relation("ReviewedOutageReports")

  operatorAssignments IncidentAssignment[] @relation("AssignedOperator")
  assignmentsCreated  IncidentAssignment[] @relation("AssignmentCreatedBy")

  bills        ElectricityBill[] @relation("CustomerBills")
  createdBills ElectricityBill[] @relation("BillCreatedBy")

  payments Payment[] @relation("CustomerPayments")

  notifications Notification[] @relation("UserNotifications")

  auditLogs AuditLog[] @relation("ActorAuditLogs")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Zone {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?

  substations Substation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
}

model Substation {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  status      InfrastructureStatus @default(ACTIVE)

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  feeders Feeder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([zoneId, name])
  @@index([zoneId])
  @@index([status])
  @@index([deletedAt])
}

model Feeder {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  capacityMw  Float?
  status      InfrastructureStatus @default(ACTIVE)

  substationId String
  substation   Substation @relation(fields: [substationId], references: [id])

  areas Area[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([substationId, name])
  @@index([substationId])
  @@index([status])
  @@index([deletedAt])
}

model Area {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  priority    AreaPriority @default(NORMAL)

  latitude  Float?
  longitude Float?

  feederId String
  feeder   Feeder @relation(fields: [feederId], references: [id])

  customers     CustomerProfile[]
  schedules     OutageSchedule[]
  outageReports OutageReport[]

  incidents OutageIncident[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([feederId, name])
  @@index([feederId])
  @@index([priority])
  @@index([deletedAt])
}

model CustomerProfile {
  id      String  @id @default(cuid())
  phone   String?
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

model OutageSchedule {
  id        String         @id @default(cuid())
  title     String
  reason    String?
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(DRAFT)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([areaId])
  @@index([createdById])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([deletedAt])
}

model OutageReport {
  id          String             @id @default(cuid())
  issueType   OutageIssueType
  description String?
  status      OutageReportStatus @default(PENDING)

  customerId String
  customer   User   @relation("CustomerOutageReports", fields: [customerId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  incidentId String?
  incident   OutageIncident? @relation(fields: [incidentId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedOutageReports", fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  reviewNote String?

  reportedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([areaId])
  @@index([status])
  @@index([issueType])
  @@index([reviewedById])
  @@index([reportedAt])
  @@index([incidentId])
}

model OutageIncident {
  id            String           @id @default(cuid())
  incidentCode  String           @unique
  title         String
  summary       String?
  status        IncidentStatus   @default(OPEN)
  severity      IncidentSeverity @default(MEDIUM)
  priorityScore Int              @default(0)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedIncidents", fields: [createdById], references: [id])

  reports     OutageReport[]
  assignments IncidentAssignment[]

  startedAt  DateTime
  restoredAt DateTime?
  closedAt   DateTime?

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([areaId])
  @@index([createdById])
  @@index([status])
  @@index([severity])
  @@index([priorityScore])
  @@index([startedAt])
  @@index([deletedAt])
}

model IncidentAssignment {
  id     String           @id @default(cuid())
  status AssignmentStatus @default(ASSIGNED)
  note   String?

  incidentId String
  incident   OutageIncident @relation(fields: [incidentId], references: [id])

  operatorId String
  operator   User   @relation("AssignedOperator", fields: [operatorId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignmentCreatedBy", fields: [assignedById], references: [id])

  assignedAt    DateTime  @default(now())
  acceptedAt    DateTime?
  workStartedAt DateTime?
  completedAt   DateTime?
  reassignedAt  DateTime?
  cancelledAt   DateTime?

  updatedAt DateTime @updatedAt

  @@index([incidentId])
  @@index([operatorId])
  @@index([assignedById])
  @@index([status])
  @@index([assignedAt])
}

model ElectricityBill {
  id         String     @id @default(cuid())
  billNumber String     @unique
  status     BillStatus @default(UNPAID)

  billingMonth Int
  billingYear  Int

  unitsConsumed Float?

  energyCharge  Decimal @db.Decimal(12, 2)
  serviceCharge Decimal @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  currency String @default("BDT")

  dueDate DateTime
  paidAt  DateTime?

  cancelledAt        DateTime?
  cancellationReason String?

  customerId String
  customer   User   @relation("CustomerBills", fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("BillCreatedBy", fields: [createdById], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, billingMonth, billingYear])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([billingYear, billingMonth])
  @@index([createdAt])
}

model Payment {
  id       String        @id @default(cuid())
  status   PaymentStatus @default(PENDING)
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("BDT")

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  billId String
  bill   ElectricityBill @relation(fields: [billId], references: [id])

  customerId String
  customer   User   @relation("CustomerPayments", fields: [customerId], references: [id])

  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  message String

  recipientId String
  recipient   User   @relation("UserNotifications", fields: [recipientId], references: [id])

  entityType String?
  entityId   String?

  dedupeKey String? @unique

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  actorRole Role?

  action      String
  entityType  String
  entityId    String?
  description String

  method    String?
  path      String?
  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
}
