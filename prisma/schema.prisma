generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InfrastructureStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum AreaPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OutageReportStatus {
  PENDING
  VERIFIED
  LINKED
  REJECTED
}

enum OutageIssueType {
  TOTAL_OUTAGE
  PARTIAL_OUTAGE
  VOLTAGE_FLUCTUATION
  OTHER
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  googleId String? @unique

  role   Role       @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  customerProfile CustomerProfile?

  createdSchedules OutageSchedule[]

  outageReports         OutageReport[] @relation("CustomerOutageReports")
  reviewedOutageReports OutageReport[] @relation("ReviewedOutageReports")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Zone {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?

  substations Substation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
}

model Substation {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  status      InfrastructureStatus @default(ACTIVE)

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  feeders Feeder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([zoneId, name])
  @@index([zoneId])
  @@index([status])
  @@index([deletedAt])
}

model Feeder {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  capacityMw  Float?
  status      InfrastructureStatus @default(ACTIVE)

  substationId String
  substation   Substation @relation(fields: [substationId], references: [id])

  areas Area[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([substationId, name])
  @@index([substationId])
  @@index([status])
  @@index([deletedAt])
}

model Area {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  priority    AreaPriority @default(NORMAL)

  latitude  Float?
  longitude Float?

  feederId String
  feeder   Feeder @relation(fields: [feederId], references: [id])

  customers     CustomerProfile[]
  schedules     OutageSchedule[]
  outageReports OutageReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([feederId, name])
  @@index([feederId])
  @@index([priority])
  @@index([deletedAt])
}

model CustomerProfile {
  id      String  @id @default(cuid())
  phone   String?
  address String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

model OutageSchedule {
  id        String         @id @default(cuid())
  title     String
  reason    String?
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(DRAFT)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([areaId])
  @@index([createdById])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([deletedAt])
}

model OutageReport {
  id          String             @id @default(cuid())
  issueType   OutageIssueType
  description String?
  status      OutageReportStatus @default(PENDING)

  customerId String
  customer   User   @relation("CustomerOutageReports", fields: [customerId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedOutageReports", fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  reviewNote String?

  reportedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([areaId])
  @@index([status])
  @@index([issueType])
  @@index([reviewedById])
  @@index([reportedAt])
}
