generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InfrastructureStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  password String?
  googleId String?    @unique
  role     Role       @default(CUSTOMER)
  status   UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Zone {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  substations Substation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
}

model Substation {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  status      InfrastructureStatus @default(ACTIVE)

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  feeders Feeder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([zoneId, name])
  @@index([zoneId])
  @@index([status])
  @@index([deletedAt])
}

model Feeder {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  capacityMw  Float?
  status      InfrastructureStatus @default(ACTIVE)

  substationId String
  substation   Substation @relation(fields: [substationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([substationId, name])
  @@index([substationId])
  @@index([status])
  @@index([deletedAt])
}
